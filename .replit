modules = ["nodejs-20", "web", "bash", "nix"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Shabiki Phone Browser"

[[workflows.workflow]]
name = "Shabiki Phone Browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash start.sh"

[[ports]]
localPort = 5000
externalPort = 80
